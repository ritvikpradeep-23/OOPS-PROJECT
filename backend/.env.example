# Copy this file to backend/.env and fill in your Neon details.
# The backend reads it on startup, so you don't need to set these in the terminal.
DATABASE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>
JWT_SECRET=any-long-random-string-at-least-32-characters
